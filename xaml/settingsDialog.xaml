<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="680" Height="600"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="LeftToRight">
    <!-- The window itself is the frame: a single rounded border fills the whole window.
         No outer grid/margin, so there is no second frame around the dialog. -->
    <Border Background="{DynamicResource SurfaceBackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
            CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Name="SettingsHeader" Grid.Row="0" Padding="24,20,24,16"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Name="SettingsTitleTextBlock" Text="{DynamicResource s_settings_title}"
                                   FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource LabelboxForegroundColor}"/>
                        <Button Name="SettingsHeaderClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                FontSize="12" Width="28" Height="28" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource MainForegroundColor}"
                                ToolTip="{DynamicResource s_settings_close}"
                                AutomationProperties.Name="{DynamicResource s_settings_close}"/>
                    </Grid>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,18">
                    <StackPanel>
                        <!-- Appearance -->
                        <TextBlock Name="SettingsAppearanceTextBlock" Text="{DynamicResource s_settings_appearance}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource LabelboxForegroundColor}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="SettingsThemeLabel" Text="{DynamicResource s_settings_theme}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MainForegroundColor}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight">
                                <Button Name="SettingsThemeAuto" Content="{DynamicResource s_auto}" Width="96" Height="28" Margin="0,0,8,0"/>
                                <Button Name="SettingsThemeDark" Content="{DynamicResource s_dark}" Width="96" Height="28" Margin="0,0,8,0"/>
                                <Button Name="SettingsThemeLight" Content="{DynamicResource s_light}" Width="96" Height="28"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="SettingsFontSizeLabel" Text="{DynamicResource s_settings_font_size}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MainForegroundColor}"/>
                            <Slider Grid.Column="1" Name="SettingsFontScalingSlider" Minimum="0.75" Maximum="2.0" Value="1.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Name="SettingsFontScalingValue" Text="100%" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Right" FlowDirection="LeftToRight"
                                       Foreground="{DynamicResource MainForegroundColor}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="120,6,0,20" FlowDirection="LeftToRight">
                            <Button Name="SettingsFontScalingReset" Content="{DynamicResource s_settings_reset}" Width="100" Height="28" Margin="0,0,8,0"/>
                            <Button Name="SettingsFontScalingApply" Content="{DynamicResource s_settings_apply}" Width="100" Height="28"/>
                        </StackPanel>

                        <!-- Language -->
                        <TextBlock Name="SettingsLanguageTextBlock" Text="{DynamicResource s_settings_language}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource LabelboxForegroundColor}"/>
                        <WrapPanel Name="SettingsLanguageItems" Orientation="Horizontal" Margin="0,0,0,20"
                                   FlowDirection="LeftToRight"/>

                        <!-- Package manager -->
                        <TextBlock Name="SettingsPackagesTextBlock" Text="{DynamicResource s_settings_packages}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource LabelboxForegroundColor}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20" FlowDirection="LeftToRight">
                            <RadioButton Name="SettingsWingetRadio" Content="WinGet" GroupName="SettingsPackageManager"
                                         IsChecked="True" Margin="0,0,22,0" FontSize="13"
                                         Foreground="{DynamicResource MainForegroundColor}"/>
                            <RadioButton Name="SettingsChocoRadio" Content="Chocolatey" GroupName="SettingsPackageManager"
                                         FontSize="13" Foreground="{DynamicResource MainForegroundColor}"/>
                        </StackPanel>

                        <!-- Data -->
                        <TextBlock Name="SettingsDataTextBlock" Text="{DynamicResource s_settings_data}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource LabelboxForegroundColor}"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Name="SettingsImportButton" Content="{DynamicResource s_settings_import}" Width="170" Height="30" Margin="0,0,8,8"/>
                            <Button Name="SettingsExportButton" Content="{DynamicResource s_settings_export}" Width="170" Height="30" Margin="0,0,8,8"/>
                            <Button Name="SettingsExportReportButton" Content="{DynamicResource s_settings_export_report}" Width="200" Height="30" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <!-- About -->
                        <TextBlock Name="SettingsAboutTextBlock" Text="{DynamicResource s_settings_about_section}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource LabelboxForegroundColor}"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Name="SettingsAboutButton" Content="{DynamicResource s_about}" Width="130" Height="30" Margin="0,0,8,8"/>
                            <Button Name="SettingsDocumentationButton" Content="{DynamicResource s_settings_documentation}" Width="170" Height="30" Margin="0,0,8,8"/>
                            <Button Name="SettingsSponsorsButton" Content="{DynamicResource s_settings_sponsors}" Width="130" Height="30" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Padding="24,14" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,1,0,0">
                    <Button Name="SettingsCloseButton" Content="{DynamicResource s_settings_close}"
                            Width="110" Height="30" HorizontalAlignment="Right"/>
                </Border>
        </Grid>
    </Border>
</Window>
